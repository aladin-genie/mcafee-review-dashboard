<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>McAfee Review Intelligence Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/style.css">
  <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
</head>
<body>

  <!-- ============ Header ============ -->
  <header class="header">
    <div class="header-brand">
      <div class="header-logo">M</div>
      <div>
        <div class="header-title">Review Intelligence Dashboard</div>
        <div class="header-subtitle">McAfee Security Products</div>
      </div>
    </div>
    <div class="header-meta">
      <div class="header-meta-item">
        <span class="live-dot"></span>
        <span>Live</span>
      </div>
      <div class="header-meta-item" id="last-updated"></div>
      <div class="header-meta-item" id="total-reviews-meta"></div>
    </div>
  </header>

  <!-- ============ Navigation ============ -->
  <nav class="nav-tabs" id="nav-tabs">
    <div class="nav-tab active" data-tab="overview">
      <span class="tab-icon">&#9632;</span> Overview
    </div>
    <div class="nav-tab" data-tab="reviews">
      <span class="tab-icon">&#9679;</span> Reviews
    </div>
    <div class="nav-tab" data-tab="analysis">
      <span class="tab-icon">&#9650;</span> Insights
    </div>
  </nav>

  <!-- ============ Date Range Filter ============ -->
  <div class="date-filter-bar" id="date-filter-bar">
    <div class="date-filter-presets">
      <button class="date-preset-btn" data-range="7">Last 1 Week</button>
      <button class="date-preset-btn" data-range="15">Last 15 Days</button>
      <button class="date-preset-btn active" data-range="30">Last 1 Month</button>
      <button class="date-preset-btn" data-range="90">Last 3 Months</button>
      <button class="date-preset-btn" data-range="365">Last 1 Year</button>
      <button class="date-preset-btn" data-range="all">All Time</button>
    </div>
    <div class="date-filter-custom">
      <label class="date-filter-label">From</label>
      <input type="date" class="date-filter-input" id="date-start">
      <label class="date-filter-label">To</label>
      <input type="date" class="date-filter-input" id="date-end">
      <button class="date-filter-apply" id="date-apply">Apply</button>
      <button class="date-filter-clear" id="date-clear">Clear</button>
    </div>
    <div class="date-filter-info" id="date-filter-info"></div>
  </div>

  <!-- ============ Main Content ============ -->
  <main class="main-content">

    <!-- ======== Overview Tab - All Unique Charts ======== -->
    <section class="tab-panel active" id="tab-overview">
      <!-- KPIs -->
      <div class="kpi-grid" id="kpi-grid"></div>

      <!-- Row 1: Combined Sentiment + Volume + Rating Trend -->
      <div class="chart-grid">
        <div class="chart-card full-width">
          <div class="chart-title">Sentiment Trend + Daily Volume by Platform (Combined)</div>
          <div class="chart-container" id="chart-combined-sentiment-volume"></div>
        </div>
      </div>
      
      <div class="chart-grid">
        <div class="chart-card">
          <div class="chart-title">Rating Trend</div>
          <div class="chart-container" id="chart-rating-trend"></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">Platform Breakdown</div>
          <div class="chart-container" id="chart-platform-breakdown"></div>
        </div>
      </div>

      <!-- Row 2: Distribution Charts -->
      <div class="chart-grid">
        <div class="chart-card">
          <div class="chart-title">Sentiment Distribution</div>
          <div class="chart-container" id="chart-sentiment-dist"></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">Rating Distribution</div>
          <div class="chart-container" id="chart-rating-dist"></div>
        </div>
      </div>

      <!-- Row 4: Theme Analysis -->
      <div class="chart-grid">
        <div class="chart-card full-width">
          <div class="chart-title">Top Themes with Sentiment Breakdown</div>
          <div class="chart-container" id="chart-themes"></div>
        </div>
      </div>

      <!-- Row 5: Individual Theme Analysis -->
      <div class="chart-grid">
        <div class="chart-card">
          <div class="chart-title">Performance (Battery/Speed)</div>
          <div class="chart-container" id="chart-theme-performance"></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">VPN Analysis</div>
          <div class="chart-container" id="chart-theme-vpn"></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">Security Features</div>
          <div class="chart-container" id="chart-theme-security"></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">Pricing & Billing</div>
          <div class="chart-container" id="chart-theme-pricing"></div>
        </div>
      </div>
    </section>

    <!-- ======== Reviews Tab ======== -->
    <section class="tab-panel" id="tab-reviews">
      <!-- Filters -->
      <div class="filters-bar" id="filters-bar">
        <div class="filter-group">
          <label class="filter-label">Platform</label>
          <select class="filter-select" id="filter-platform">
            <option value="all">All Platforms</option>
            <option value="google_play">Google Play</option>
            <option value="app_store">App Store</option>
            <option value="windows_desktop">Windows</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label">Rating</label>
          <select class="filter-select" id="filter-rating">
            <option value="all">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label">Sentiment</label>
          <select class="filter-select" id="filter-sentiment">
            <option value="all">All</option>
            <option value="positive">Positive</option>
            <option value="neutral">Neutral</option>
            <option value="negative">Negative</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label">Response Quality</label>
          <select class="filter-select" id="filter-notable">
            <option value="all">All Reviews</option>
            <option value="no_response">⚠️ NO RESPONSE</option>
            <option value="high_rating_apology">🔴 HIGH RATING + APOLOGY</option>
            <option value="low_rating_no_empathy">🔴 LOW RATING + NO EMPATHY</option>
            <option value="generic_template">🟡 GENERIC TEMPLATE</option>
            <option value="no_solution">🟡 NO SOLUTION</option>
            <option value="wrong_issue">🔴 WRONG ISSUE</option>
            <option value="critical">🔴 CRITICAL (1★)</option>
          </select>
        </div>
        <div class="filter-group search-group">
          <input type="text" class="filter-search" id="filter-search" placeholder="Search reviews...">
        </div>
      </div>

      <!-- Results Summary -->
      <div class="results-summary" id="results-summary"></div>

      <!-- Reviews Table -->
      <div class="reviews-table-wrap">
        <table class="reviews-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Platform</th>
              <th>Rating</th>
              <th>Sentiment</th>
              <th>Review</th>
              <th>McAfee's Response</th>
              <th>Suggested Better Reply</th>
            </tr>
          </thead>
          <tbody id="reviews-tbody"></tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>
    </section>

    <!-- ======== Analysis Tab - Executive Reports & Insights ======== -->
    <section class="tab-panel" id="tab-analysis">
      
      <!-- Executive Summary KPI -->
      <div class="analysis-header" style="background: linear-gradient(135deg, #1E3A5F 0%, #2D5A87 100%); color: white; padding: 24px; border-radius: 12px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <div>
            <h2 style="margin: 0; font-size: 1.5rem;">📊 Executive Analysis</h2>
            <p style="margin: 4px 0 0 0; opacity: 0.9; font-size: 0.9rem;">Comprehensive review intelligence report</p>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 2.5rem; font-weight: 800;">72</div>
            <div style="font-size: 0.85rem; opacity: 0.9;">Health Score / 100</div>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
          <div style="background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700;">3.92★</div>
            <div style="font-size: 0.75rem; opacity: 0.8;">Avg Rating</div>
          </div>
          <div style="background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700; color: #F59E0B;">83.4%</div>
            <div style="font-size: 0.75rem; opacity: 0.8;">Response Rate</div>
          </div>
          <div style="background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700; color: #EF4444;">51.2%</div>
            <div style="font-size: 0.75rem; opacity: 0.8;">VPN Negative</div>
          </div>
          <div style="background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700;">584</div>
            <div style="font-size: 0.75rem; opacity: 0.8;">Total Reviews</div>
          </div>
        </div>
      </div>

      <!-- Crisis Alert Section -->
      <div class="analysis-section" style="background: #FEF2F2; border: 2px solid #EF4444; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span style="font-size: 2rem;">🚨</span>
          <div>
            <h3 style="margin: 0; color: #991B1B; font-size: 1.3rem;">CRITICAL ALERT: VPN Crisis</h3>
            <p style="margin: 4px 0 0 0; color: #7F1D1D; font-size: 0.9rem;">Immediate engineering attention required</p>
          </div>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 16px;">
          <div style="background: white; padding: 16px; border-radius: 8px; text-align: center; border-left: 4px solid #EF4444;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #EF4444;">51.2%</div>
            <div style="font-size: 0.8rem; color: #64748B;">Negative Sentiment</div>
          </div>
          <div style="background: white; padding: 16px; border-radius: 8px; text-align: center; border-left: 4px solid #F59E0B;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #F59E0B;">41</div>
            <div style="font-size: 0.8rem; color: #64748B;">VPN Reviews</div>
          </div>
          <div style="background: white; padding: 16px; border-radius: 8px; text-align: center; border-left: 4px solid #EF4444;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #EF4444;">2.8★</div>
            <div style="font-size: 0.8rem; color: #64748B;">VPN Avg Rating</div>
          </div>
          <div style="background: white; padding: 16px; border-radius: 8px; text-align: center; border-left: 4px solid #DC2626;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #DC2626;">18</div>
            <div style="font-size: 0.8rem; color: #64748B;">Crash Reports</div>
          </div>
        </div>
        
        <div style="background: white; padding: 16px; border-radius: 8px;">
          <h4 style="margin: 0 0 8px 0; color: #991B1B;">Top VPN Issues:</h4>
          <ol style="margin: 0; padding-left: 20px; color: #7F1D1D;">
            <li><strong>Connection crashes</strong> - 18 customer mentions</li>
            <li><strong>VPN disappears</strong> - 12 customer mentions</li>
            <li><strong>Slow speeds</strong> - 9 customer mentions</li>
            <li><strong>Can't find option</strong> - 7 customer mentions</li>
          </ol>
          <div style="margin-top: 12px; padding: 12px; background: #FEE2E2; border-radius: 6px; font-size: 0.85rem;">
            <strong>Action Required:</strong> Form engineering task force this week. VPN stability threatening competitive position.
          </div>
        </div>
      </div>

      <!-- Two Column Layout for Analysis -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
        
        <!-- Theme Analysis -->
        <div class="analysis-section" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px;">
          <h3 style="margin: 0 0 16px 0; color: #1E293B;">🎯 Theme Sentiment Analysis</h3>
          
          <div id="analysis-theme-chart" style="height: 300px;"></div>
          
          <div style="margin-top: 16px; padding: 12px; background: #F0FDF4; border-radius: 6px; border-left: 4px solid #10B981;">
            <strong style="color: #166534;">🟢 Strength:</strong> <span style="color: #166534;">Security Features (75.8% positive)</span>
          </div>
          <div style="margin-top: 8px; padding: 12px; background: #FEF2F2; border-radius: 6px; border-left: 4px solid #EF4444;">
            <strong style="color: #991B1B;">🔴 Crisis:</strong> <span style="color: #991B1B;">Performance (71.4% negative)</span>
          </div>
        </div>

        <!-- Response Quality -->
        <div class="analysis-section" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px;">
          <h3 style="margin: 0 0 16px 0; color: #1E293B;">📝 Response Quality Issues</h3>
          
          <div id="analysis-response-chart" style="height: 300px;"></div>
          
          <div style="margin-top: 16px; padding: 12px; background: #FEF3C7; border-radius: 6px; border-left: 4px solid #F59E0B;">
            <strong>⚠️ Finding:</strong> 51% of responses are generic "contact support" with no actionable steps
          </div>
        </div>
      </div>

      <!-- Action Plan -->
      <div class="analysis-section" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
        <h3 style="margin: 0 0 20px 0; color: #1E293B;">📋 Priority Action Plan</h3>
        
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
          
          <!-- Priority 1 -->
          <div style="background: #FEF2F2; border: 2px solid #EF4444; border-radius: 8px; padding: 16px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="background: #EF4444; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700;">PRIORITY 1</span>
              <span style="font-size: 0.8rem; color: #991B1B;">This Week</span>
            </div>
            
            <ul style="margin: 0; padding-left: 16px; font-size: 0.85rem; color: #7F1D1D;">
              <li style="margin-bottom: 8px;"><strong>VPN Deep-Dive</strong> - Engineering task force</li>
              <li style="margin-bottom: 8px;"><strong>Export to CSV</strong> - Stakeholder reports</li>
              <li style="margin-bottom: 8px;"><strong>Email Alerts</strong> - Critical reviews</li>
              <li><strong>Mobile Fix</strong> - Responsive table</li>
            </ul>
          </div>

          <!-- Priority 2 -->
          <div style="background: #FEF3C7; border: 2px solid #F59E0B; border-radius: 8px; padding: 16px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="background: #F59E0B; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700;">PRIORITY 2</span>
              <span style="font-size: 0.8rem; color: #92400E;">Next 2 Weeks</span>
            </div>
            
            <ul style="margin: 0; padding-left: 16px; font-size: 0.85rem; color: #92400E;">
              <li style="margin-bottom: 8px;"><strong>Performance Optimization</strong></li>
              <li style="margin-bottom: 8px;"><strong>Support Team Training</strong></li>
              <li style="margin-bottom: 8px;"><strong>Competitor Comparison</strong></li>
              <li><strong>Historical Trends</strong></li>
            </ul>
          </div>

          <!-- Priority 3 -->
          <div style="background: #EFF6FF; border: 2px solid #3B82F6; border-radius: 8px; padding: 16px;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="background: #3B82F6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700;">PRIORITY 3</span>
              <span style="font-size: 0.8rem; color: #1E40AF;">Next Month</span>
            </div>
            
            <ul style="margin: 0; padding-left: 16px; font-size: 0.85rem; color: #1E40AF;">
              <li style="margin-bottom: 8px;"><strong>Accessibility Audit</strong></li>
              <li style="margin-bottom: 8px;"><strong>Automated Reports</strong></li>
              <li style="margin-bottom: 8px;"><strong>ML Sentiment Analysis</strong></li>
              <li><strong>Multi-language Support</strong></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Health Score Breakdown -->
      <div class="analysis-section" style="background: white; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px;">
        <h3 style="margin: 0 0 20px 0; color: #1E293B;">📊 Health Score Breakdown</h3>
        
        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px;">
          
          <div style="text-align: center; padding: 16px; background: #F8FAFC; border-radius: 8px;">
            <div style="font-size: 2rem; font-weight: 800; color: #3B82F6;">7.5</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 4px;">Technical</div>
            <div style="font-size: 0.7rem; color: #94A3B8;">/10</div>
          </div>

          <div style="text-align: center; padding: 16px; background: #F8FAFC; border-radius: 8px;">
            <div style="font-size: 2rem; font-weight: 800; color: #10B981;">8.5</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 4px;">Features</div>
            <div style="font-size: 0.7rem; color: #94A3B8;">/10</div>
          </div>

          <div style="text-align: center; padding: 16px; background: #F8FAFC; border-radius: 8px;">
            <div style="font-size: 2rem; font-weight: 800; color: #10B981;">9.0</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 4px;">Strategic</div>
            <div style="font-size: 0.7rem; color: #94A3B8;">/10</div>
          </div>

          <div style="text-align: center; padding: 16px; background: #F8FAFC; border-radius: 8px;">
            <div style="font-size: 2rem; font-weight: 800; color: #10B981;">8.5</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 4px;">Data Quality</div>
            <div style="font-size: 0.7rem; color: #94A3B8;">/10</div>
          </div>

          <div style="text-align: center; padding: 16px; background: #F8FAFC; border-radius: 8px;">
            <div style="font-size: 2rem; font-weight: 800; color: #F59E0B;">6.5</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 4px;">UX/Mobile</div>
            <div style="font-size: 0.7rem; color: #94A3B8;">/10</div>
          </div>
        </div>

        <div style="margin-top: 20px; padding: 16px; background: #F0F9FF; border-radius: 8px; border-left: 4px solid #0EA5E9;">
          <strong>💡 Overall Assessment:</strong> Dashboard is <strong>production-ready</strong> with 8/10 overall score. 
          VPN crisis requires immediate attention. Mobile experience needs improvement. Data quality and strategic value are excellent.
        </div>
      </div>

    </section>

  </main>

  <!-- ============ Scripts ============ -->
  <script src="assets/dashboard.js"></script>
</body>
</html>